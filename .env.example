# API endpoint (frontend calls backend here)
VITE_API_BASE_URL=http://localhost:3000

# Public keys only
VITE_OTHER_API_KEYS=some_api_key_here

# Redis (choose one style)
# Option A: full connection URL (Upstash/Redis Cloud)
# REDIS_URL=redis://:PASSWORD@hostname:6379

# Option B: host/port/credentials
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PASS=
